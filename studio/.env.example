# Kopieer dit bestand naar .env en vul je eigen project-id in.
# Je vindt die op sanity.io/manage, of in de uitvoer van `npx sanity init`.
SANITY_STUDIO_PROJECT_ID=7x379x0b
SANITY_STUDIO_DATASET=production

# Enkel nodig om de startproducten te importeren (npm run seed).
# Maak een token met schrijfrechten op sanity.io/manage > API > Tokens.
# Zet dit NOOIT in git.
SANITY_WRITE_TOKEN=
